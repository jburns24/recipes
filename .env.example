# Copy to .env for local use. `task dev` already sets safe local defaults.

# --- API ---
PORT=3000
# NODE_ENV=production disables dev auth and the Claude stub (the API refuses to start with them).
NODE_ENV=development

# --- Auth ---
# supabase (default; required in production) | dev (local only, refused when NODE_ENV=production)
AUTH_MODE=dev
# AUTH_MODE=dev: clients send "Authorization: Bearer <DEV_AUTH_TOKEN>" (min 8 chars)
DEV_AUTH_TOKEN=dev-token
# AUTH_MODE=supabase: HS256 secret (Project Settings > API > JWT secret) and/or SUPABASE_URL for JWKS (ES256/RS256)
SUPABASE_JWT_SECRET=
# Comma-separated, case-insensitive. Empty = any authenticated Supabase user.
ALLOWED_EMAILS=

# --- Store ---
# file (default, uses ./data) | supabase
STORE=file
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# --- Recipe extraction (POST /api/extract) ---
ANTHROPIC_API_KEY=
# 1 = deterministic fake extractor (tests/e2e/no key). Refused when NODE_ENV=production.
CLAUDE_STUB=

# --- Web (Vite, build-time; only VITE_* is exposed to the browser) ---
# dev = fake sign-in with DEV_AUTH_TOKEN (only honored by `vite dev`, stripped from production builds)
# supabase = Google OAuth via Supabase. Defaults to dev under `task dev`.
VITE_AUTH_MODE=dev
VITE_DEV_AUTH_TOKEN=dev-token
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
