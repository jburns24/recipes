# Copy to .env for local use. `task dev` already sets safe local defaults.

# --- API ---
PORT=3000
# NODE_ENV=production disables dev auth and the Claude stub (the API refuses to start with them).
NODE_ENV=development

# --- Auth ---
# supabase (default; required in production) | dev (local only, refused when NODE_ENV=production)
AUTH_MODE=dev
# AUTH_MODE=dev: clients send "Authorization: Bearer <DEV_AUTH_TOKEN>" (min 8 chars)
DEV_AUTH_TOKEN=dev-token
# AUTH_MODE=supabase verifies the user's access token. Current projects sign those
# tokens with asymmetric keys, checked via JWKS at
# $SUPABASE_URL/auth/v1/.well-known/jwks.json. There is no shared JWT secret.
# Set SUPABASE_JWT_SECRET only for a legacy project that still uses HS256.
SUPABASE_JWT_SECRET=
# Comma-separated, case-insensitive. Empty = any authenticated Supabase user.
# Required when NODE_ENV=production (an empty list is refused).
ALLOWED_EMAILS=

# --- Store ---
# file (default, uses ./data) | supabase
STORE=file
# DATA_DIR=./data
SUPABASE_URL=
# New API keys are not JWTs. They replace the legacy anon / service_role keys:
#   sb_publishable_...  browser and other public clients (was the anon key)
#   sb_secret_...       server only; bypasses RLS (was the service_role key)
# Send them on the apikey header only. Do not put them in Authorization: Bearer.
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# --- Recipe extraction (POST /api/extract) ---
ANTHROPIC_API_KEY=
# Claude Haiku 5.5. Empty uses that default. Any other Claude API model id overrides it.
CLAUDE_MODEL=
# low (default) | medium | high | xhigh | max. Lower effort = faster but less accuracy.
CLAUDE_EFFORT=low
# 1 = deterministic fake extractor (tests/e2e/no key). Refused when NODE_ENV=production.
CLAUDE_STUB=

# --- Web (Vite, build-time; only VITE_* is exposed to the browser) ---
# dev = fake sign-in with DEV_AUTH_TOKEN (only honored by `vite dev`, stripped from production builds)
# supabase = Google OAuth via Supabase. Defaults to dev under `task dev`.
VITE_AUTH_MODE=dev
VITE_DEV_AUTH_TOKEN=dev-token
# Publishable key (sb_publishable_...), the same value as SUPABASE_ANON_KEY above.
# The Docker frontend image receives these as build-args from GitHub repo variables.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
